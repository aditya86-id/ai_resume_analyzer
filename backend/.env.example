# ========================================================
# Security
# ========================================================
SECRET_KEY=your-super-secret-django-key-change-in-production-12345!@#$%
DEBUG=True

# ========================================================
# Database
# ========================================================
# For Production (PostgreSQL on Render)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_resume_analyzer
DB_USER=postgres
DB_PASSWORD=your-secure-password-from-render
DB_HOST=your-postgres-db.onrender.com
DB_PORT=5432

# For Local Development, use SQLite:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ========================================================
# API Keys
# ========================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ========================================================
# CORS
# ========================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,https://your-frontend.onrender.com

# ========================================================
# ALLOWED HOSTS
# ========================================================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-backend.onrender.com

# ========================================================
# Frontend URL
# ========================================================
FRONTEND_URL=https://your-frontend.onrender.com

# ========================================================
# Environment
# ========================================================
ENVIRONMENT=development

# ========================================================
# Production Security Settings (uncomment for production)
# ========================================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
